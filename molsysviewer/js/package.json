{
  "name": "@uibcdf/molsysviewer",
  "version": "0.14.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/uibcdf/molsysviewer",
    "directory": "molsysviewer/js"
  },
  "files": [
    "dist/*"
  ],
  "type": "module",
  "scripts": {
    "sync:pyversion": "node scripts/sync-python-version.mjs",
    "build": "npm run sync:pyversion && node scripts/build-runtime.mjs",
    "build:test:js": "npx esbuild tests/unit/index.test.ts --bundle --platform=node --format=esm --outfile=tests/unit/dist-index.js",
    "test:js": "npm run build:test:js && node --test tests/unit/dist-index.js",
    "coverage:js": "npm run build:test:js && npx c8 --reporter=lcov --report-dir=coverage-js node --test tests/unit/dist-index.js",
    "build:harness": "npx esbuild tests/e2e/harness.ts --bundle --format=iife --global-name=Harness --outfile=tests/e2e/harness.bundle.js",
    "build:e2e": "npx esbuild tests/e2e/region-hide.e2e.ts --bundle --platform=node --format=esm --outfile=tests/e2e/region-hide.e2e.js --external:playwright --external:chromium-bidi/*",
    "build:e2e:annotations": "npx esbuild tests/e2e/annotations-interaction.e2e.ts --bundle --platform=node --format=esm --outfile=tests/e2e/annotations-interaction.e2e.js --external:playwright --external:chromium-bidi/*",
    "build:e2e:shapes": "npx esbuild tests/e2e/shape-trajectory.e2e.ts --bundle --platform=node --format=esm --outfile=tests/e2e/shape-trajectory.e2e.js --external:playwright --external:chromium-bidi/*",
    "build:e2e:export": "npx esbuild tests/e2e/export-replay.e2e.ts --bundle --platform=node --format=esm --outfile=tests/e2e/export-replay.e2e.js --external:playwright --external:chromium-bidi/*",
    "test:e2e": "npm run build:harness && npm run build:e2e && node tests/e2e/region-hide.e2e.js",
    "test:e2e:annotations": "npm run build:harness && npm run build:e2e:annotations && node tests/e2e/annotations-interaction.e2e.js",
    "test:e2e:shapes": "npm run build:harness && npm run build:e2e:shapes && node tests/e2e/shape-trajectory.e2e.js",
    "test:e2e:export": "npm run build:harness && npm run build:e2e:export && node tests/e2e/export-replay.e2e.js",
    "build:e2e:workflow": "npx esbuild tests/e2e/workflow-integration.e2e.ts --bundle --platform=node --format=esm --outfile=tests/e2e/workflow-integration.e2e.js --external:playwright --external:chromium-bidi/*",
    "test:e2e:workflow": "npm run build:harness && npm run build:e2e:workflow && node tests/e2e/workflow-integration.e2e.js"
  },
  "dependencies": {
    "molstar": "^5.4.1"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "esbuild": "^0.27.0",
    "playwright": "^1.57.0",
    "typescript": "^5.6.0"
  },
  "pythonVersion": "0.14.0+3.g7e16f6d.dirty"
}
